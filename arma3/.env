ARMA_BINARY=./arma3server_x64
ARMA_CONFIG=server.cfg
NETWORK_CONFIG=basic.cfg
ARMA_LIMITFPS=100
ARMA_PROFILE=main
ARMA_WORLD=empty
ARMA_PARAMS="-par=configs/params.cfg -maxFileCacheSize=8192" # maxFileCacheSize not supported in -par
HEADLESS_CLIENTS=1
HEADLESS_CLIENTS_PROFILE="headlessclient\$ii"
MODS_LOCAL=false
MODS_PRESET=
CLEAR_KEYS=false
PORT=2302
EXPOSE_PORT_BASE=230
STEAM_BRANCH=creatordlc
STEAM_BRANCH_PASSWORD=
STEAM_PASSWORD=snip
STEAM_USER=snip
SKIP_INSTALL=true

# uncomment to enable install
#SKIP_INSTALL=false
#ARMA_CDLC="ws;vn"
